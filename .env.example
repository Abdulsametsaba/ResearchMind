# Application
APP_NAME=ResearchMind
APP_ENV=development
DEBUG=true
CROSS_ORIGIN=http://localhost:5173

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL_PLANNER=gemini-3.6-flash
GEMINI_MODEL_FAST=gemini-3.1-flash-lite
GEMINI_MODEL_EMBEDDING=gemini-embedding-001
GEMINI_TEMPERATURE=0.2

# Search providers
TAVILY_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# PostgreSQL
POSTGRES_USER=researchmind
POSTGRES_PASSWORD=
POSTGRES_DB=researchmind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://researchmind:change_me@localhost:5432/researchmind

# Optional observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ResearchMind

# Frontend
VITE_API_URL=
